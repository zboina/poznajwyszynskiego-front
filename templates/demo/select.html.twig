{% extends 'base.html.twig' %}

{% block title %}Tryb demo — wybierz typ konta | poznajwyszynskiego.pl{% endblock %}

{% set roles = [
    {id: 'guest',   icon: 'ti-user-off', name: 'Gość',        sub: 'Bez rejestracji',       cta: 'Wejdź jako gość',
     features: [['yes', 'Wyszukiwarka tytułów i treści'], ['yes', 'Lista dokumentów i tomów'], ['yes', 'Podgląd metadanych dokumentu'],
                ['no', 'Odczyt pełnej treści'], ['no', 'Więcej niż 10 wyników'], ['no', 'Eksport do PDF']]},
    {id: 'user',    icon: 'ti-user',     name: 'Użytkownik',  sub: 'Bezpłatna rejestracja', cta: 'Wejdź jako użytkownik',
     features: [['yes', 'Wyszukiwarka tytułów i treści'], ['yes', 'Lista dokumentów i tomów'], ['yes', 'Podgląd metadanych dokumentu'],
                ['partial', 'Odczyt treści: 5 tekstów na dobę'], ['no', 'Więcej niż 10 wyników'], ['no', 'Eksport do PDF']]},
    {id: 'donator', icon: 'ti-heart',    name: 'Donator',     sub: 'Wsparcie projektu',     cta: 'Wejdź jako donator',
     features: [['yes', 'Wyszukiwarka tytułów i treści'], ['yes', 'Lista dokumentów i tomów'], ['yes', 'Podgląd metadanych dokumentu'],
                ['yes', 'Odczyt treści bez limitu'], ['yes', '20 wyników na stronę'], ['no', 'Eksport do PDF']]},
    {id: 'vip',     icon: 'ti-crown',    name: 'VIP',         sub: 'Pełny dostęp',          cta: 'Wejdź jako VIP',
     features: [['yes', 'Wyszukiwarka tytułów i treści'], ['yes', 'Lista dokumentów i tomów'], ['yes', 'Podgląd metadanych dokumentu'],
                ['yes', 'Odczyt treści bez limitu'], ['yes', '20 wyników na stronę'], ['yes', 'Eksport do PDF i biblioteka']]},
] %}

{% block stylesheets %}
<style>
    .demo-page { padding: 0 1rem 3rem; }
    .demo-badge {
        background: linear-gradient(135deg, var(--pw-maroon), var(--pw-maroon-dark));
        color: #fff; text-align: center; padding: .5rem 1rem; font-size: .72rem; font-weight: 700;
        letter-spacing: .12em; text-transform: uppercase; margin: 0 -1rem; }
    .demo-badge a { color: var(--pw-gold); text-decoration: none; margin-left: 1rem; }
    .demo-badge a:hover { text-decoration: underline; }

    .demo-head { text-align: center; margin: 3rem auto 2.25rem; max-width: 560px; }
    .demo-head h1 { font-family: var(--font-heading); color: var(--pw-ink); font-weight: 700;
        font-size: clamp(1.7rem, 4vw, 2.3rem); margin: 0 0 .5rem; }
    .demo-head p { color: var(--pw-muted); margin: 0; line-height: 1.6; }

    .roles-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.1rem; max-width: 1100px; margin: 0 auto; }
    .role-card {
        display: flex; flex-direction: column; text-align: center; text-decoration: none; color: inherit;
        background: var(--pw-paper); border: 1px solid var(--pw-line); border-radius: var(--pw-radius);
        box-shadow: var(--pw-shadow); padding: 1.6rem 1.4rem 1.4rem;
        transition: transform .18s, box-shadow .18s, border-color .18s; }
    .role-card:hover { color: inherit; transform: translateY(-3px); border-color: var(--pw-gold-soft);
        box-shadow: 0 2px 4px rgba(60,40,20,.05), 0 16px 36px rgba(60,40,20,.10); }
    .role-card.active { border-color: var(--pw-maroon); box-shadow: 0 0 0 3px rgba(114,47,55,.12), var(--pw-shadow); }

    .role-icon { width: 54px; height: 54px; border-radius: 50%; margin: 0 auto .9rem;
        display: flex; align-items: center; justify-content: center; font-size: 1.5rem;
        background: var(--pw-cream); border: 1px solid var(--pw-line); color: var(--pw-maroon); }
    .role-card--guest .role-icon { color: var(--pw-faint); }
    .role-card--user .role-icon { color: var(--pw-navy); }
    .role-card--vip .role-icon { color: var(--pw-gold); }

    .role-name { font-family: var(--font-heading); font-size: 1.3rem; font-weight: 700; color: var(--pw-ink); }
    .role-sub { font-size: .8rem; color: var(--pw-faint); margin: .15rem 0 1.1rem; }

    .role-features { list-style: none; padding: 0; margin: 0 0 1.25rem; text-align: left; flex: 1;
        font-size: .86rem; line-height: 1.45; }
    .role-features li { display: flex; gap: .5rem; align-items: flex-start; padding: .28rem 0; color: var(--pw-ink); }
    .role-features li i { flex: 0 0 auto; font-size: 1rem; margin-top: .05rem; }
    .role-features li.yes i { color: #2f7d5b; }
    .role-features li.partial i { color: #b7791f; }
    .role-features li.no { color: var(--pw-faint); }
    .role-features li.no i { color: #c9bfb0; }

    .role-action { display: block; border-radius: 10px; padding: .6rem 1rem; font-weight: 600; font-size: .88rem;
        border: 1px solid var(--pw-maroon); color: var(--pw-maroon); background: transparent; transition: background .15s, color .15s; }
    .role-card:hover .role-action { background: rgba(114,47,55,.06); }
    .role-card--vip .role-action { background: var(--pw-maroon); color: #fff; }
    .role-card--vip:hover .role-action { background: var(--pw-maroon-dark); }
</style>
{% endblock %}

{% block body %}
<div class="page demo-page">
    <div class="demo-badge">
        Tryb demo — prezentacja dostępów
        <a href="{{ path('app_demo_exit') }}">Zakończ demo</a>
    </div>

    <div class="demo-head">
        <h1>Wybierz typ konta</h1>
        <p>Każdy poziom dostępu daje inne możliwości. Wybierz rolę, aby zobaczyć serwis oczami danego użytkownika.</p>
    </div>

    <div class="roles-grid">
        {% for r in roles %}
            <a href="{{ path('app_demo_activate', {role: r.id}) }}" class="role-card role-card--{{ r.id }} {{ currentRole == r.id ? 'active' : '' }}">
                <div class="role-icon"><i class="ti {{ r.icon }}"></i></div>
                <div class="role-name">{{ r.name }}</div>
                <div class="role-sub">{{ r.sub }}</div>
                <ul class="role-features">
                    {% for f in r.features %}
                        <li class="{{ f[0] }}"><i class="ti {{ f[0] == 'yes' ? 'ti-circle-check' : (f[0] == 'partial' ? 'ti-clock' : 'ti-circle-x') }}"></i><span>{{ f[1] }}</span></li>
                    {% endfor %}
                </ul>
                <span class="role-action">{{ r.cta }}</span>
            </a>
        {% endfor %}
    </div>
</div>
{% endblock %}
